# MediProcure AI — Environment Configuration Example
# Copy to .env for local development

# Application Environment (development, testing, production)
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration
# Default fallback: SQLite for seamless local development & offline demos
DATABASE_URL=sqlite:///./mediprocure.db
# PostgreSQL / Supabase example (uncomment for PostgreSQL):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mediprocure

# Gmail API & Agent Integration Mode
# Options: SIMULATED (offline safe demo mode) | LIVE (requires credentials.json and token.json)
GMAIL_MODE=SIMULATED

# Frontend CORS Allowed Origins (comma-separated, supporting Vite on port 5173 and Next/React on 3000)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Audit & Logging
LOG_LEVEL=INFO
